# OpenAI: the machine's ear (/api/hear), corrections and replies (/api/turn), わたしの声 and Mia's and Sam's voices
# (/api/say, scripts/generate-audio.mjs), word times and checks of the clips (generate-audio)
OPENAI_API_KEY=
# Optional: another model for corrections and replies (default gpt-5.5), its effort (default low), another
# transcription model (default gpt-4o-transcribe), and the whole-service ceiling of answers per server instance per day
TALK_MODEL=
TALK_EFFORT=
HEAR_MODEL=
TURNS_PER_DAY=

# Signs the English the app's AI wrote, so /api/say voices only that (any long random string)
SAY_SECRET=

# Vertex AI: Gemini text-to-speech for Leo and Nora, in ことのあめ's project. Without it their replies fall back to
# OpenAI voices, and scripts/generate-audio.mjs cannot voice their lines
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=

# ことのあめ's Supabase project (its accounts; the record is kept in sh_records, read and written as the learner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ことのあめ's address (default https://polylinga.vercel.app), for an account or a forgotten password
NEXT_PUBLIC_KOTONOAME_URL=
# 1 once ことのあめ knows this app (kotonokage in its src/lib/sisters.ts, deployed): shows ことのあめでつなぐ on /login
NEXT_PUBLIC_KOTONOAME_CONNECT=
# Optional: ことのあめ's Google OAuth client, once this app's addresses are among its authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
